# Kolla-Ansible Multinode Inventory
# OpenStack 2024.1 (Caracal) Production Deployment
# Author: rasheshpatel <rasheshkumar.patel@gmail.com>
#
# Node layout:
#   Deploy node    : 10.0.1.10 (local)
#   Controllers    : 10.0.1.11 - 10.0.1.13  (HA, Keepalived VIP 10.0.1.100)
#   Compute nodes  : 10.0.1.21 - 10.0.1.24
#   Storage nodes  : 10.0.1.31 - 10.0.1.33  (Ceph OSD on /dev/sdb)

# ---------------------------------------------------------------------------
# Physical / Role groups
# ---------------------------------------------------------------------------

[control]
10.0.1.11 ansible_user=ubuntu ansible_become=true
10.0.1.12 ansible_user=ubuntu ansible_become=true
10.0.1.13 ansible_user=ubuntu ansible_become=true

[compute]
10.0.1.21 ansible_user=ubuntu ansible_become=true
10.0.1.22 ansible_user=ubuntu ansible_become=true
10.0.1.23 ansible_user=ubuntu ansible_become=true
10.0.1.24 ansible_user=ubuntu ansible_become=true

[storage]
10.0.1.31 ansible_user=ubuntu ansible_become=true
10.0.1.32 ansible_user=ubuntu ansible_become=true
10.0.1.33 ansible_user=ubuntu ansible_become=true

[network]
10.0.1.11
10.0.1.12
10.0.1.13

[monitoring]
10.0.1.11
10.0.1.12
10.0.1.13

[deployment]
10.0.1.10 ansible_connection=local

